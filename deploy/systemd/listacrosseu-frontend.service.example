[Unit]
Description=ListAcrossEU Next.js frontend
After=network.target

[Service]
Type=simple
User=<DEPLOY_USER>
Group=<DEPLOY_GROUP>
WorkingDirectory=<FRONTEND_DIR>
EnvironmentFile=<FRONTEND_ENV_FILE>
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target
