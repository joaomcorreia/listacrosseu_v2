DJANGO_SETTINGS_MODULE=listacrosseu_backend.settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-secret-key-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3004
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3004
STAGING_NOINDEX=1
EXPOSE_PUBLIC_DEBUG_ENDPOINTS=1
ENABLE_VISUAL_HOMEPAGE_EDITOR=0
# Explicit local-only entitlement test hook; leave disabled by default.
GENERATED_WEBSITE_ATTRIBUTION_TEST_ELIGIBLE=0
