DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=staging.example.com,api.staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com,https://api.staging.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://staging.example.com
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.listacross\.eu$
NEXT_PUBLIC_SITE_URL=https://staging.example.com
DATABASE_URL=postgres://user:password@127.0.0.1:5432/listacrosseu_staging
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=0
RESEND_API_KEY=
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=ListAcrossEU <noreply@listacross.eu>
SERVER_EMAIL=ListAcrossEU <noreply@listacross.eu>
STATIC_ROOT=/srv/listacrosseu/backend/staticfiles
MEDIA_ROOT=/srv/listacrosseu/backend/media
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_LOG_LEVEL=INFO
STAGING_NOINDEX=1
EXPOSE_PUBLIC_DEBUG_ENDPOINTS=0
ENABLE_VISUAL_HOMEPAGE_EDITOR=0
